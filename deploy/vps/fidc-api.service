[Unit]
Description=Dashboard FIDC API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dashboard-fidc/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/dashboard-fidc/backend/.env
ExecStart=/opt/dashboard-fidc/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8003 --workers 2 --timeout-keep-alive 75
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
